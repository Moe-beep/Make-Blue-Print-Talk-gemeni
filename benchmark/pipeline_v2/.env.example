# Copy to .env (never committed) and fill in. Variables set in the shell override these.

# GPU VM for `python main.py ... ` (empty = run on this machine). See deploy/verda/README.md.
JUNCTION_REMOTE=root@<VM_IP>
# Private SSH key used for the VM (the matching .pub is the one added in the Verda console).
JUNCTION_SSH_KEY=~/.ssh/id_ed25519
# Project folder on the VM, relative to the SSH home.
JUNCTION_REMOTE_DIR=junction

# LLM agent (ask.py / answer.py)
GEMINI_API_KEY=
